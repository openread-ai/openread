NEXT_PUBLIC_APP_PLATFORM=web

# Default-off client exposure for MCP settings and API-key UI.
NEXT_PUBLIC_OPENREAD_MCP_ENABLED=0

# Sentry web error monitoring/source maps (optional).
# Public DSN enables browser/server Sentry for web builds after telemetry consent checks.
NEXT_PUBLIC_SENTRY_DSN=
# Build-time source-map upload target. Keep SENTRY_PROJECT in sync with the Sentry project slug.
SENTRY_ORG=openreadai
SENTRY_PROJECT=javascript-nextjs
# Optional explicit release. If omitted, Vercel git SHA/package version fallback is used.
SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
# Build secret only; configure in CI/Vercel, do not commit a real token.
SENTRY_AUTH_TOKEN=

# Apple IAP server verification. Configure only in the server/Vercel environment.
# APPLE_IAP_APPLE_ID is the numeric App Apple ID, not the bundle ID.
APPLE_IAP_APPLE_ID=
APPLE_IAP_BUNDLE_ID=
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
# Canonical base64 of the App Store Connect In-App Purchase .p8 private key.
APPLE_IAP_PRIVATE_KEY_BASE64=

# Google Play IAP server verification. Leave unset until Android billing activation.
# Canonical base64 of a least-privilege Google service-account JSON document.
GOOGLE_IAP_SERVICE_ACCOUNT_JSON_BASE64=
