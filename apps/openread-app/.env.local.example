# Optional public PostHog project token and matching region host. Configure both or neither.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Server-only Groq credential for local cloud-AI testing.
GROQ_API_KEY=

# Optional Sentry web error monitoring/source maps.
# Do not commit real DSNs/tokens; SENTRY_AUTH_TOKEN belongs only in CI/Vercel build secrets.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=openreadai
SENTRY_PROJECT=javascript-nextjs
SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
SENTRY_AUTH_TOKEN=

# Stripe test-mode billing for local development.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional Upstash Redis. Configure both values together or leave both unset.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

NEXT_PUBLIC_STORAGE_FIXED_QUOTA=1073741824

NEXT_PUBLIC_API_BASE_URL=https://your-api-base-url.com

SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# r2, s3
NEXT_PUBLIC_OBJECT_STORAGE_TYPE=r2

R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
R2_BUCKET=YOUR_R2_BUCKET
R2_ACCOUNT_ID=YOUR_R2_ACCOUNT_ID

TEMP_STORAGE_PUBLIC_BUCKET_NAME=PLACE_HOLDER
