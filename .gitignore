# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# turborepo
.turbo

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
/certs

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# env files
.env
.env.*
!.env.example
!.env.*.example
!.env.*.template

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Generated workspace package output. Never commit these directories.
# Tracked copies caused repeated stale-artefact incidents (#541).
# Enforced by scripts/ops/check-untracked-package-dist.mjs
packages/*/dist
packages/*/dist/

# Rust build
target

fastlane/report.xml

*.koplugin.zip

# nix
result*
.mcp.json
.worktrees/

# Claude Code session state
.claude/worktrees/
.claude/*.local.md

# Skills are machine-level, never repo-tracked
.claude/skills/

# Session telemetry (per-machine)
docs/analytics/
apps/api/docs/analytics/
apps/openread-app/docs/analytics/

# Storybook build output
apps/openread-app/storybook-static/

# Playwright artifacts and MCP session state
apps/openread-app/test-results/
apps/openread-app/playwright-report/
.playwright-mcp/

# Local validation evidence and scratch runners
artifacts/
apps/openread-app/artifacts/

# Pi local/user preferences
# Keep personal themes and settings in ~/.pi/agent rather than the repo.
.pi/themes/
.pi/*.local.json
.pi/settings.json
apps/openread-app/.pi/

# Pi session exports
pi-*-session.html
pi-session-*.html

# Start Dev local state
.startdev/

# Supabase CLI local scratch (contains project ref / pooler URL)
supabase/.temp/
