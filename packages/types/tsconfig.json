{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@openread/tsconfig/node-library.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.test-d.ts"]
}
