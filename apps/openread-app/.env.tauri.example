NEXT_PUBLIC_APP_PLATFORM=tauri
AI_GATEWAY_API_KEY=your_key_here

# Optional native/Tauri Rust crash monitoring.
# SENTRY_DSN is intentionally server/native scoped (not NEXT_PUBLIC_*); configure per desktop/native runtime.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
# Error event sample rate, 0..1. Defaults to 1.0 when omitted.
SENTRY_SAMPLE_RATE=
