{
  "name": "@openread/monorepo",
  "private": true,
  "repository": "openread-ai/platform",
  "scripts": {
    "preflight:changed-files": "node scripts/ci/changed-files-preflight.mjs",
    "preflight:selector-drift": "node scripts/ci/check-preflight-selector-drift.mjs",
    "billing:verify-contract": "node scripts/billing/verify-contract.mjs",
    "db:migrations:validate": "node scripts/db/validate-supabase-migrations.mjs",
    "ops:runtime:check": "bash scripts/ops/check-runtime-config.sh",
    "ci:runner-health:check": "node scripts/ci/test-select-linux-runner.mjs",
    "lifecycle:artifacts:scan": "node scripts/ops/scan-lifecycle-artifacts.mjs",
    "lifecycle:artifacts:test": "node --test scripts/ops/scan-lifecycle-artifacts.test.mjs",
    "service:deploy-contract:check": "python3 scripts/ops/semantic-fly-config.py self-test && node scripts/ops/summarize-service-proxy-log.mjs --self-test && node scripts/db/check-pending-supabase-migrations.mjs --self-test && node scripts/ops/check-service-revisions.mjs --self-test && node scripts/ops/service-deploy-hardening.mjs --self-test && node scripts/ops/pull-pinned-image.mjs --self-test && bash scripts/ops/check-service-deploy-shell.sh && node scripts/ops/check-service-deploy-contract.mjs --self-test",
    "catalog:health:doab-dry-run:check": "node scripts/ops/check-catalog-health-doab-dry-run-workflow.mjs && node scripts/ops/check-catalog-health-reverify-dry-run-report.mjs --self-test",
    "api:ownership:check": "node scripts/ops/check-api-route-ownership.mjs",
    "api:ownership:self-test": "node scripts/ops/check-api-route-ownership.mjs --self-test",
    "api:route-capabilities:check": "node scripts/ops/check-route-capabilities.mjs",
    "api:route-capabilities:test": "node --test scripts/ops/check-route-capabilities.test.mjs",
    "book-identity:check": "node scripts/ops/check-book-identity-ownership.mjs",
    "auth:boundary:check": "node scripts/ops/check-canonical-auth-boundary.mjs",
    "ai-control:boundary:check": "node scripts/ops/check-canonical-ai-control-boundary.mjs",
    "persistence:check": "node scripts/ops/check-local-persistence-registry.mjs",
    "sync:check": "node scripts/ops/check-canonical-sync-cleanup.mjs",
    "compatibility:tombstones:check": "node scripts/ops/check-compatibility-tombstones.mjs",
    "dist:untracked:check": "node scripts/ops/check-untracked-package-dist.mjs",
    "dist:untracked:test": "node --test scripts/ops/check-untracked-package-dist.test.mjs",
    "environment:manifest:check": "node scripts/ops/check-environment-manifest.mjs",
    "environment:manifest:test": "node --test scripts/ops/notion-env.test.mjs scripts/ops/check-environment-manifest.test.mjs scripts/env/run-with-env.test.mjs",
    "env:bootstrap": "node scripts/env/run-with-env.mjs bootstrap --target development/local",
    "env:check": "node scripts/env/run-with-env.mjs check --target development/local --service web",
    "env:test": "node --test scripts/env/run-with-env.test.mjs",
    "env:run": "node scripts/env/run-with-env.mjs run",
    "env:supabase:start": "supabase start && node scripts/env/sync-local-supabase.mjs",
    "env:supabase:sync": "node scripts/env/sync-local-supabase.mjs",
    "env:dev:web": "node scripts/env/run-with-env.mjs run --target development/local --service web -- pnpm --filter @openread/openread-app dev-web",
    "environment:privileged:check": "node scripts/ops/check-privileged-env-loading.mjs",
    "environment:privileged:test": "node --test scripts/ops/check-privileged-env-loading.test.mjs scripts/ops/privileged-env-loader.test.mjs",
    "tauri": "pnpm --filter @openread/openread-app tauri",
    "dev-web": "pnpm --filter @openread/openread-app dev-web",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,css,json,md,html,yml}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,css,json,md,html,yml}\"",
    "prepare": "husky || true"
  },
  "packageManager": "pnpm@10.28.1+sha512.7d7dbbca9e99447b7c3bf7a73286afaaf6be99251eb9498baefa7d406892f67b879adb3a1d7e687fc4ccc1a388c7175fbaae567a26ab44d1067b54fcb0d6a316",
  "engines": {
    "node": "22.x"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.9.1",
    "@sindresorhus/tsconfig": "^6.0.0",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.6",
    "lint-staged": "^16.2.7",
    "lru-cache": "^11.2.5",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "typescript": "^5",
    "yaml": "^2.8.2"
  },
  "lint-staged": {
    "apps/openread-app/**/*.{ts,tsx,js,jsx}": [
      "eslint --fix --max-warnings=0 --config apps/openread-app/eslint.config.mjs",
      "prettier --write"
    ],
    "*.{ts,tsx,js,jsx}": [
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,html}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "glob": ">=11.1.0",
      "jws": ">=4.0.1",
      "vite": ">=7.0.8",
      "body-parser": ">=2.2.1",
      "@babel/runtime": ">=7.26.10",
      "@babel/helpers": ">=7.26.10",
      "mdast-util-gfm-autolink-literal": "2.0.1",
      "minimatch@3/brace-expansion": "^1.1.7",
      "brace-expansion@>=2.0.0 <4.0.1": ">=4.0.1",
      "cross-spawn@>=7.0.0 <7.0.5": ">=7.0.5",
      "cookie@<0.7.0": ">=0.7.0",
      "tmp@<=0.2.3": ">=0.2.4",
      "esbuild@<0.25.0": ">=0.25.0",
      "fast-xml-parser": ">=5.10.0 <6"
    },
    "patchedDependencies": {
      "mdast-util-gfm-autolink-literal@2.0.1": "patches/mdast-util-gfm-autolink-literal@2.0.1.patch"
    }
  }
}
